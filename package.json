{
  "name": "@molesignal/cli",
  "version": "0.3.0",
  "description": "MoleSignal on the command line: logs, metrics, traces, incidents and approvals, deployments, source maps and symbols from CI, and MCP over stdio for AI agent tools",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "molesignal": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "molesignal",
    "observability",
    "logs",
    "metrics",
    "traces",
    "apm",
    "rum",
    "source-maps",
    "deployments",
    "incidents",
    "mcp",
    "model-context-protocol",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molesignal/molesignal-cli.git"
  },
  "bugs": {
    "url": "https://github.com/molesignal/molesignal-cli/issues"
  },
  "homepage": "https://github.com/molesignal/molesignal-cli#readme",
  "author": {
    "name": "MoleSignal",
    "email": "opensource@molesignal.io"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "undici": "6.29.1"
  }
}
